# Copy to .env (never commit it) and restrict it: chmod 600 .env

# From your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Required unless you use TOKEN_ENCRYPTION_KEY_FILE (Docker secret or TPM-sealed key; see README).
# Encrypts stored Spotify tokens. Generate once with: openssl rand -base64 32
# Changing or losing it just logs everyone out.
TOKEN_ENCRYPTION_KEY=

# Public URL the browser uses. Must match the redirect URI registered in the Spotify dashboard
# (<APP_BASE_URL>/login/oauth2/code/spotify). For local use keep 127.0.0.1, not localhost.
APP_BASE_URL=http://127.0.0.1:8080

# Set to true when serving over HTTPS (behind a reverse proxy).
SESSION_COOKIE_SECURE=false
